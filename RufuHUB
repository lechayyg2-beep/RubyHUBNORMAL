-- ============================================================
-- RESPAWN HANDLING
-- ============================================================
local function resetAll()
    stopFly()
    if _G.InfJumpConnection then
        _G.InfJumpConnection:Disconnect()
        _G.InfJumpConnection = nil
    end
    if _G.NoClipConnection then
        _G.NoClipConnection:Disconnect()
        _G.NoClipConnection = nil
    end
    if antiAFKConn then
        antiAFKConn:Disconnect()
        antiAFKConn = nil
    end
    if wallhackEnabled then
        applyWallhack(false)
        wallhackEnabled = false
    end
    if espEnabled then
        updateESP(false)
        espEnabled = false
    end
    stopAntiCheat()
end

player.CharacterRemoving:Connect(resetAll)

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    walkSpeed = getFlag("WalkSpeed") or 16
    jumpPower = getFlag("JumpPower") or 50
    gravity = getFlag("Gravity") or 196.2
    humanoid.WalkSpeed = walkSpeed
    humanoid.JumpPower = jumpPower
    workspace.Gravity = gravity

    if getFlag("FlyMode") then
        flyEnabled = true
        startFly()
    end
    if getFlag("NoClip") then
        _G.NoClipConnection = RunService.Stepped:Connect(function()
            local c = player.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    if getFlag("InfJump") then
        local canJump = true
        local cooldown = 0.3
        local function req()
            if canJump and humanoid and humanoid.Parent then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                canJump = false
                task.wait(cooldown)
                canJump = true
            end
        end
        _G.InfJumpConnection = UIS.JumpRequest:Connect(req)
    end
    if getFlag("AntiAFK") then
        antiAFKConn = RunService.Heartbeat:Connect(function() end)
    end
    if getFlag("Wallhack") then
        wallhackEnabled = true
        applyWallhack(true)
    end
    if getFlag("ESP_Master") then
        espEnabled = true
        updateESP(true)
    end
    if getFlag("NoFog") then
        game:GetService("Lighting").FogEnd = 999999
    end
    if getFlag("Brightness") then
        game:GetService("Lighting").Brightness = getFlag("Brightness")
    end

    -- Start anti-cheat protection for speed/jump/gravity
    if not antiCheatRunning then startAntiCheat() end
end)
