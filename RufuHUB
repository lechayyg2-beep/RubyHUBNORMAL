-- VISUALS: WALLHACK
-- ============================================================
Visuals:CreateSection("Wallhack")

local wallhackEnabled = false
local originalTrans = {}
local wallhackAdded = nil

local function applyWallhack(enable)
    if enable then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Transparency < 1 then
                originalTrans[obj] = obj.Transparency
                obj.Transparency = 0.25
            end
        end
        wallhackAdded = workspace.DescendantAdded:Connect(function(child)
            if wallhackEnabled and child:IsA("BasePart") and child.Transparency < 1 then
                originalTrans[child] = child.Transparency
                child.Transparency = 0.25
            end
        end)
    else
        if wallhackAdded then
            wallhackAdded:Disconnect()
            wallhackAdded = nil
        end
        for part, orig in pairs(originalTrans) do
            if part and part.Parent then
                part.Transparency = orig
            end
        end
        originalTrans = {}
    end
end

Visuals:CreateToggle({
    Name = "Wallhack (X-Ray)",
    CurrentValue = false,
    Flag = "Wallhack",
    Callback = function(v)
        wallhackEnabled = v
        applyWallhack(v)
    end
})

